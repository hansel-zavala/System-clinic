---
import LayoutBase from '../layouts/LayoutBase.astro';

const departments = [
  {
    name: "Cardiología Avanzada",
    description: "Imágenes cardiovasculares de última generación, exámenes preventivos y manejo integral de afecciones cardíacas por parte de destacados electrofisiólogos y cirujanos.",
    icon: "cardiology",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  },
  {
    name: "Pediatría",
    description: "Atención dedicada para bebés, niños y adolescentes, centrada en hitos del desarrollo, vacunas, exámenes de bienestar y el manejo de enfermedades agudas.",
    icon: "child_care",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  },
  {
    name: "Medicina General",
    description: "Médicos de atención primaria que actúan como tu primer punto de contacto para la salud preventiva, el manejo de condiciones crónicas y consultas de rutina.",
    icon: "stethoscope",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  },
  {
    name: "Neurología Clínica",
    description: "Evaluaciones diagnósticas y tratamientos expertos para trastornos del cerebro, la médula espinal y los nervios, incluyendo migrañas, accidentes cerebrovasculares y trastornos cognitivos.",
    icon: "psychology",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  },
  {
    name: "Ortopedia y Medicina Deportiva",
    description: "Tratamiento de afecciones óseas, articulares, de ligamentos, tendones y músculos. Cirugía artroscópica avanzada, reemplazo de articulaciones y cuidados de rehabilitación.",
    icon: "physical_therapy",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  },
  {
    name: "Diagnóstico e Imágenes",
    description: "Resonancia magnética de alta resolución, tomografía computarizada, radiografías digitales, ultrasonidos y laboratorios de patología avanzada para resultados rápidos y precisos.",
    icon: "biotech",
    bgColor: "bg-primary/5",
    textColor: "text-primary"
  }
];
---

<LayoutBase title="Nuestros Servicios - MedClinic">
  <main class="pt-32 pb-xl px-margin-mobile md:px-gutter max-w-max-width mx-margin-desktop space-y-xl">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto space-y-sm">
      <div class="inline-flex items-center space-x-xs bg-primary-fixed text-primary px-sm py-xs rounded-full font-label-md text-label-md">
        <span class="material-symbols-outlined text-[16px]">medical_services</span>
        <span>Departamentos</span>
      </div>
      <h1 class="font-display text-[48px] md:text-[56px] text-on-surface leading-tight tracking-tight">
        Especialidades de <span class="italic font-light text-primary">Clase Mundial</span>
      </h1>
      <p class="font-body text-body-lg text-on-surface-variant leading-relaxed">
        Ofrecemos departamentos clínicos completos, atendidos por especialistas certificados que utilizan las últimas tecnologías médicas para apoyar tu recuperación.
      </p>
    </div>

    <!-- Rejilla de Servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
      {departments.map((dept) => (
        <div class="bg-surface border border-outline rounded-lg p-lg flex flex-col justify-between hover:border-primary hover:-translate-y-1 transition-all duration-300 shadow-[0_2px_8px_-4px_rgba(20,61,38,0.02)] group">
          <div>
            <div class={`w-12 h-12 ${dept.bgColor} rounded-sm flex items-center justify-center mb-md group-hover:scale-105 transition-transform`}>
              <span class={`material-symbols-outlined ${dept.textColor} text-[24px]`} style="font-variation-settings: 'FILL' 1;">
                {dept.icon}
              </span>
            </div>
            <h2 class="font-display text-[26px] text-on-surface mb-sm">{dept.name}</h2>
            <p class="font-body text-body-md text-on-surface-variant mb-md leading-relaxed">{dept.description}</p>
          </div>
          <a 
            href="/booking/"
            class="text-primary font-label-md text-label-md flex items-center gap-xs hover:underline pt-md border-t border-outline/50 w-full justify-between"
          >
            <span>Reservar con un Especialista</span>
            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">chevron_right</span>
          </a>
        </div>
      ))}
    </div>

    <!-- Sección de Llamada a la Acción -->
    <div class="bg-primary text-surface rounded-lg p-lg md:p-xl flex flex-col md:flex-row justify-between items-center gap-md shadow-[0_8px_30px_-8px_rgba(20,61,38,0.18)]">
      <div class="space-y-xs max-w-2xl text-center md:text-left">
        <h3 class="font-display text-[32px] md:text-[38px] leading-tight">¿Necesitas Ayuda Inmediata?</h3>
        <p class="font-body text-body-md text-surface-container-low leading-relaxed">
          Nuestro asistente digital está disponible las 24 horas, los 7 días de la semana para coordinar tu reserva o dirigirte al departamento adecuado.
        </p>
      </div>
      <a 
        href="/booking/"
        class="bg-surface text-primary font-label-md text-label-md px-lg py-sm rounded-sm hover:bg-opacity-95 transition-all flex items-center gap-xs shrink-0 shadow-md active:scale-95"
      >
        <span class="material-symbols-outlined">smart_toy</span>
        <span>Iniciar Reserva Ahora</span>
      </a>
    </div>
  </main>
</LayoutBase>
