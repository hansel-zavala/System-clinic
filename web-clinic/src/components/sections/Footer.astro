---
---
<footer class="bg-surface-container-high w-full pt-xl pb-md border-t border-outline text-on-surface">
  <div class="max-w-[1200px] mx-auto px-margin-mobile md:px-gutter grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-xl">
    
    <!-- Columna 1: Marca, Lema y Redes Sociales -->
    <div class="flex flex-col space-y-md">
      <div class="flex items-center gap-xs font-display text-[26px] font-medium text-primary tracking-tight">
        <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 1;">medical_services</span>
        <span>Clinica Aura</span>
      </div>
      <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
        Brindando atención médica de última generación en un entorno compasivo y tranquilo. Tu recuperación es nuestra prioridad.
      </p>
      
      <!-- Redes Sociales (Animaciones sutiles y colores de marca en hover) -->
      <div class="flex items-center space-x-sm pt-xs">
        <!-- Facebook -->
        <a 
          href="https://facebook.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-sm bg-surface border border-outline flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-surface hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200"
          aria-label="Facebook"
        >
          <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24" width="18" height="18">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a 
          href="https://instagram.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-sm bg-surface border border-outline flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-surface hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200"
          aria-label="Instagram"
        >
          <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24" width="18" height="18">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a 
          href="https://wa.me/1234567890" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-sm bg-surface border border-outline flex items-center justify-center text-on-surface-variant hover:bg-[#25D366] hover:text-white hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200"
          aria-label="WhatsApp"
        >
          <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24" width="18" height="18">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.864-9.864.002-2.637-1.019-5.117-2.877-6.979C16.6 1.897 14.128.877 11.493.877c-5.447 0-9.873 4.424-9.877 9.869-.001 1.734.457 3.428 1.328 4.921l-.982 3.585 3.685-.966zm12.338-7.202c-.328-.164-1.94-.959-2.241-1.07-.302-.109-.522-.164-.74.164-.219.328-.847 1.07-1.039 1.288-.192.219-.384.246-.712.082-.328-.164-1.386-.51-2.64-1.627-.975-.87-1.633-1.945-1.825-2.273-.192-.329-.021-.507.143-.671.147-.148.328-.384.493-.575.164-.192.219-.328.328-.547.11-.219.055-.411-.027-.575-.082-.164-.74-1.78-.1013-2.438-.287-.692-.522-.6-.713-.6-.19-.009-.411-.014-.63-.014-.22 0-.575.082-.876.411-.302.328-1.15 1.122-1.15 2.738 0 1.617 1.178 3.178 1.342 3.397.164.219 2.317 3.538 5.613 4.961.783.339 1.396.541 1.873.692.788.251 1.505.216 2.072.13.632-.094 1.94-.793 2.214-1.56.274-.767.274-1.423.192-1.56-.082-.136-.301-.218-.63-.382z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna 2: Enlaces de Navegación -->
    <div class="flex flex-col space-y-md sm:pl-md">
      <h3 class="font-display text-[18px] font-medium text-primary">Navegación</h3>
      <ul class="space-y-sm font-body text-body-md text-on-surface-variant">
        <li>
          <a href="/#home" class="hover:text-primary transition-colors focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Inicio</a>
        </li>
        <li>
          <a href="/#about" class="hover:text-primary transition-colors focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Nosotros</a>
        </li>
        <li>
          <a href="/#services" class="hover:text-primary transition-colors focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Servicios</a>
        </li>
        <li>
          <a href="/#location" class="hover:text-primary transition-colors focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Ubicación</a>
        </li>
        <li>
          <a href="/#contact" class="hover:text-primary transition-colors focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Contacto</a>
        </li>
        <li>
          <a href="/booking/" class="text-primary font-bold hover:underline focus:ring-1 focus:ring-primary rounded px-xs -mx-xs py-0.5 block">Reservar Cita</a>
        </li>
      </ul>
    </div>

    <!-- Columna 3: Servicios Médicos -->
    <div class="flex flex-col space-y-md">
      <h3 class="font-display text-[18px] font-medium text-primary">Nuestros Servicios</h3>
      <ul class="space-y-sm font-body text-body-md text-on-surface-variant">
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Cardiología Avanzada</a>
        </li>
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Pediatría</a>
        </li>
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Medicina General</a>
        </li>
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Diagnósticos y Laboratorio</a>
        </li>
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Neurología Clínica</a>
        </li>
        <li>
          <a href="/servicios/" class="hover:text-primary transition-colors block">Ortopedia y Traumatología</a>
        </li>
      </ul>
    </div>

    <!-- Columna 4: Contacto y Horarios -->
    <div class="flex flex-col space-y-md">
      <h3 class="font-display text-[18px] font-medium text-primary">Contacto y Horarios</h3>
      <div class="space-y-sm font-body text-body-md text-on-surface-variant">
        <div class="flex items-start space-x-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary mt-0.5">location_on</span>
          <span>1200 Healthcare Dr, Suite 400<br/>Metropolitan City, NY 10001</span>
        </div>
        <div class="flex items-center space-x-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary">call</span>
          <span>(555) 019-2834</span>
        </div>
        <div class="flex items-center space-x-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary">mail</span>
          <span>info@medclinic.com</span>
        </div>
        <div class="pt-xs border-t border-outline/50 flex flex-col space-y-0.5">
          <p class="font-bold text-on-surface text-[14px]">Horarios de Atención:</p>
          <p class="text-[14px]">Lun - Vie: 8:00 AM - 8:00 PM</p>
          <p class="text-[14px]">Sábados: 9:00 AM - 2:00 PM</p>
          <p class="text-[14px] text-error font-medium">Domingos: Cerrado</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Barra Inferior: Derechos Reservados -->
  <div class="max-w-[1200px] mx-auto mt-xl pt-md border-t border-outline/50 px-margin-mobile md:px-gutter flex flex-col sm:flex-row justify-between items-center text-caption font-caption text-on-surface-variant gap-sm">
    <div>
      © 2024 MedClinic. Todos los derechos reservados.
    </div>
    <div class="flex space-x-md">
      <a class="hover:text-primary transition-colors" href="#">Política de Privacidad</a>
      <a class="hover:text-primary transition-colors" href="#">Términos de Servicio</a>
      <a class="hover:text-primary transition-colors" href="#">Accesibilidad</a>
    </div>
  </div>
</footer>
